import gymnasium as gym
from gymnasium import spaces
import numpy as np


class DockingEnvSAC(gym.Env):
    metadata = {"render_modes": []}

    def __init__(self, df):
        super().__init__()

        self.df = df.reset_index(drop=True)

        self.n_molecules = len(self.df)
        self.current_step = 0

        # Same selection budget as PPO/DQN/A2C
        self.selection_budget = int(0.30 * self.n_molecules)
        self.selected_count = 0

        # Continuous action space for SAC
        self.action_space = spaces.Box(
            low=-1.0,
            high=1.0,
            shape=(1,),
            dtype=np.float32
        )

        # Same observation as previous models
        self.observation_space = spaces.Box(
            low=np.array([0.0, -100.0], dtype=np.float32),
            high=np.array([1.0, 0.0], dtype=np.float32),
            dtype=np.float32
        )

    def reset(self, seed=None, options=None):
        super().reset(seed=seed)

        self.current_step = 0
        self.selected_count = 0

        obs = np.array([
            self.current_step / self.n_molecules,
            self.df.loc[self.current_step, "Binding Energy"]
        ], dtype=np.float32)

        return obs, {}

    def step(self, action):

        # Convert continuous SAC action into binary decision
        decision = 1 if float(action[0]) >= 0 else 0

        binding = self.df.loc[self.current_step, "Binding Energy"]

        # Same reward function as PPO/DQN/A2C
        if binding <= Q1:
            reward = 5 if decision == 1 else -5

        elif binding <= Q2:
            reward = 3 if decision == 1 else -3

        elif binding <= Q3:
            reward = 1 if decision == 1 else -1

        else:
            reward = -5 if decision == 1 else 5

        # Budget penalty
        if decision == 1:
            self.selected_count += 1

            if self.selected_count > self.selection_budget:
                reward -= 10

        self.current_step += 1

        terminated = self.current_step >= self.n_molecules
        truncated = False

        if terminated:
            obs = np.zeros(2, dtype=np.float32)
        else:
            obs = np.array([
                self.current_step / self.n_molecules,
                self.df.loc[self.current_step, "Binding Energy"]
            ], dtype=np.float32)

        info = {
            "decision": decision,
            "binding_energy": binding
        }

        return obs, reward, terminated, truncated, info

    def render(self):
        pass

    def close(self):
        pass




