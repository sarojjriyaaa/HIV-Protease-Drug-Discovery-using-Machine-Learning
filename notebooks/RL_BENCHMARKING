def evaluate_model(model, env, df, algo_name):
    """
    Evaluate a trained RL model and save all outputs.
    """

    obs, _ = env.reset()
    # Automatically detect column names
    ligand_col = "Ligand"
    binding_col = "Binding Energy"

    done = False

    rewards = []
    decisions = []

    selected_rows = []
    all_rows = []

    while not done:

        action, _ = model.predict(obs, deterministic=True)

        # Handle SAC continuous action
        if algo_name == "SAC":
            decision = 1 if float(action[0]) >= 0 else 0
        else:
            decision = int(action)

        next_obs, reward, terminated, truncated, info = env.step(action)

        done = terminated or truncated

        rewards.append(reward)
        decisions.append(decision)

        row = df.iloc[env.current_step - 1]

        record = {
            "Ligand": row[ligand_col],
            "Binding Energy": row[binding_col],
            "Decision": decision,
            "Reward": reward
        }

        all_rows.append(record)

        if decision == 1:
            selected_rows.append(record)

        obs = next_obs

    # -------------------------------------------------------
    # Convert to DataFrames
    # -------------------------------------------------------

    selected_df = pd.DataFrame(selected_rows)
    all_df = pd.DataFrame(all_rows)

    # -------------------------------------------------------
    # Binding-energy categories
    # -------------------------------------------------------

    def category(x):

        if x <= -13:
            return "Excellent"

        elif x <= -12:
            return "Good"

        elif x <= -11.2:
            return "Moderate"

        else:
            return "Poor"

    if len(selected_df) > 0:

        selected_df["Category"] = selected_df["Binding Energy"].apply(category)

        category_counts = Counter(selected_df["Category"])

        mean_be = selected_df["Binding Energy"].mean()
        std_be = selected_df["Binding Energy"].std()

    else:

        category_counts = Counter()

        mean_be = np.nan
        std_be = np.nan

    # -------------------------------------------------------
    # Statistics
    # -------------------------------------------------------

    stats = {

        "Algorithm": algo_name,

        "Training Time": None,

        "Average Reward": np.mean(rewards),

        "Maximum Reward": np.max(rewards),

        "Minimum Reward": np.min(rewards),

        "Selection Budget": env.selection_budget,

        "Selected": sum(decisions),

        "Rejected": len(decisions) - sum(decisions),

        "Mean Binding Energy": mean_be,

        "Std Binding Energy": std_be,

        "Excellent": category_counts["Excellent"],

        "Good": category_counts["Good"],

        "Moderate": category_counts["Moderate"],

        "Poor": category_counts["Poor"]

    }

    # -------------------------------------------------------
    # Save CSV files
    # -------------------------------------------------------

    selected_df.to_csv(
        f"results/{algo_name}/selected_ligands.csv",
        index=False
    )

    all_df.to_csv(
        f"results/{algo_name}/all_predictions.csv",
        index=False
    )

    # -------------------------------------------------------
    # Save statistics
    # -------------------------------------------------------

    with open(f"results/{algo_name}/statistics.txt", "w") as f:

        for key, value in stats.items():
            f.write(f"{key}: {value}\n")

    print("=" * 60)
    print(f"{algo_name} RESULTS")
    print("=" * 60)

    for key, value in stats.items():
        print(f"{key:25s}: {value}")

    return stats, selected_df, all_df


df = pd.read_excel("Docking_data.xlsx")


class DockingEnv(gym.Env):

    def __init__(self, df):

        super().__init__()

        self.df = df.sample(frac=1, random_state=42).reset_index(drop=True)

        self.n_molecules = len(self.df)

        self.current_step = 0

        # 30% screening budget
        self.selection_budget = int(0.30 * self.n_molecules)

        self.selected_count = 0

        self.action_space = spaces.Discrete(2)

        self.observation_space = spaces.Box(
            low=np.array([0.0, -20.0], dtype=np.float32),
            high=np.array([1.0, 0.0], dtype=np.float32),
            dtype=np.float32
        )

    def reset(self, seed=None, options=None):

        super().reset(seed=seed)

        self.df = self.df.sample(frac=1).reset_index(drop=True)

        self.current_step = 0

        self.selected_count = 0

        return self._get_state(), {}

    def _get_state(self):

        energy = self.df.loc[self.current_step, "Binding Energy"]

        return np.array(
            [
                self.current_step / self.n_molecules,
                energy
            ],
            dtype=np.float32
        )

    def step(self, action):

        energy = self.df.loc[self.current_step, "Binding Energy"]

        # --------------------------
        # Molecule Quality
        # --------------------------

        if energy <= Q1:
            quality = "Excellent"

        elif energy <= Q2:
            quality = "Good"

        elif energy <= Q3:
            quality = "Moderate"

        else:
            quality = "Poor"

        # --------------------------
        # Reward
        # --------------------------

        if quality == "Excellent":

            reward = 5 if action == 1 else -5

        elif quality == "Good":

            reward = 3 if action == 1 else -3

        elif quality == "Moderate":

            reward = 1 if action == 1 else -1

        else:

            reward = -5 if action == 1 else 5

        # --------------------------
        # Screening Budget
        # --------------------------

        if action == 1:

            self.selected_count += 1

            if self.selected_count > self.selection_budget:

                reward -= 10

        # --------------------------
        # Next state
        # --------------------------

        self.current_step += 1

        terminated = self.current_step >= self.n_molecules

        if terminated:

            obs = np.zeros(2, dtype=np.float32)

        else:

            obs = self._get_state()

        return obs, reward, terminated, False, {}


