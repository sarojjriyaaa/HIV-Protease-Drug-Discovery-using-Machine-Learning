import random
class DockingEnv:
    def __init__(self, df):
        self.df = df
        self.n = len(df)
    def reset(self):
        # start from random ligand
        self.index = random.randint(0, self.n - 1)
        state = self.df.iloc[self.index]
        return state
    def step(self, action):
        # action = choose ligand index
        self.index = action
        state = self.df.iloc[self.index]
        reward = state["Reward"]
        done = True   # one-step environment
        return state, reward, done

env = DockingEnv(df)
state = env.reset()
print("Initial state:\n", state)
action = random.randint(0, len(df)-1)
next_state, reward, done = env.step(action)
print("\nNext state:\n", next_state)
print("\nReward:", reward)

import random
env = DockingEnv(df)
best_reward = -999
best_ligand = None

for episode in range(50):
    state = env.reset()
    action = random.randint(0, len(df)-1)
    next_state, reward, done = env.step(action)
    if reward > best_reward:
        best_reward = reward
        best_ligand = next_state["Ligand"]
    print(f"Episode {episode}: Ligand {next_state['Ligand']} → Reward {reward}")

print("\nBest Ligand Found:", best_ligand)
print("Best Reward:", best_reward)

